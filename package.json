{
  "name": "hearthbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "chrome >= 87"
  ],
  "scripts": {
    "dev": "node scripts/link-fixtures.mjs && pnpm --filter @hearthbox/shell dev",
    "build": "pnpm -r --filter=!@hearthbox/hbx build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "format": "prettier --write .",
    "fixtures": "pnpm --filter @hearthbox/fixture-contract build && node scripts/link-fixtures.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "eslint-plugin-compat": "^6.0.2",
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.64.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
