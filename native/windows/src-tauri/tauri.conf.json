{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hearthbox",
  "version": "0.1.0",
  "identifier": "app.hearthbox.desktop",
  "build": {
    "frontendDist": "../../../apps/shell/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "炉边",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 450,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
